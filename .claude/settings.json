{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent(office-intake)",
      "Agent(office-research)",
      "Agent(office-writer)",
      "Agent(office-auditor)",
      "Agent(office-records)",
      "Edit(/workspace/01-intake/**)",
      "Edit(/workspace/02-research/**)",
      "Edit(/workspace/03-drafts/**)",
      "Edit(/workspace/04-audit/**)",
      "Edit(/workspace/05-records/**)"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "mcp__*",
      "Edit(/.claude/**)",
      "Edit(/workspace/00-requests/**)",
      "Edit(/workspace/materials/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/README_最初に読む.md)",
      "Edit(/CHECKSUMS_SHA256.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Read|Glob|Grep|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\"",
            "timeout": 6000
          }
        ]
      }
    ]
  }
}
